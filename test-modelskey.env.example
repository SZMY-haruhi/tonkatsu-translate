# Tonkatsu Translate — local smoke credentials template
# Copy to test-modelskey.env (gitignored). Never commit real keys.

# --- Recommended: local Ollama Hunyuan-MT / Hy-MT ---
TEST_ENGINE=local-openai
TEST_LOCAL_RUNTIME=ollama
TEST_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
TEST_LOCAL_MODEL=hy-mt2-1.8b-fixed:latest
TEST_LOCAL_API_KEY=
TEST_MAX_CONCURRENCY=2

# --- Optional: DeepL ---
# TEST_ENGINE=deepl
# TEST_DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
# TEST_MAX_CONCURRENCY=3

# --- Optional: cloud OpenAI-compatible (quality spot-check) ---
# TEST_ENGINE=openai-compatible
# TEST_API_KEY=
# TEST_BASE_URL=https://api.siliconflow.cn/v1
# TEST_MODEL=tencent/Hunyuan-MT-7B
